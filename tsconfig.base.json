{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@closing/authentification/data-access": [
        "libs/authentification/data-access/src/index.ts"
      ],
      "@closing/authentification/feature": [
        "libs/authentification/feature/src/index.ts"
      ],
      "@closing/authentification/feature-shell": [
        "libs/authentification/feature-shell/src/index.ts"
      ],
      "@closing/dashboard/data-access": [
        "libs/dashboard/data-access/src/index.ts"
      ],
      "@closing/dashboard/feature": ["libs/dashboard/feature/src/index.ts"],
      "@closing/dashboard/feature-shell": [
        "libs/dashboard/feature-shell/src/index.ts"
      ],
      "@closing/users/data-access": ["libs/users/data-access/src/index.ts"],
      "@closing/users/feature": ["libs/users/feature/src/index.ts"],
      "@closing/users/feature-shell": ["libs/users/feature-shell/src/index.ts"],
      "@closing/layout/feature": ["libs/layout/feature/src/index.ts"],
      "@closing/layout/feature-shell": [
        "libs/layout/feature-shell/src/index.ts"
      ],
      "@closing/session/data-access": ["libs/session/data-access/src/index.ts"],
      "@closing/session/feature": ["libs/session/feature/src/index.ts"],
      "@closing/session/feature-shell": [
        "libs/session/feature-shell/src/index.ts"
      ],
      "@closing/shared/data-access": ["libs/shared/data-access/src/index.ts"],
      "@closing/shared/interfaces": ["libs/shared/interfaces/src/index.ts"],
      "@closing/shared/ui-feature": ["libs/shared/ui-feature/src/index.ts"],
      "@closing/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@closing/tree/data-access": ["libs/tree/data-access/src/index.ts"],
      "@closing/tree/feature": ["libs/tree/feature/src/index.ts"],
      "@closing/tree/feature-shell": ["libs/tree/feature-shell/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
